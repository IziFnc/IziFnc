<?xml version="1.0" encoding="utf-8"?>
<!-- Os dados financeiros não saem do aparelho por backup automático do Android
     (nem para a nuvem, nem na migração de celular). O backup é o arquivo que a
     própria pessoa salva em Configurações > Dados. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
