  "fixed_sql": [
    {
      "name": "accounts",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"accounts\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"name\" TEXT NOT NULL, \"kind\" TEXT NOT NULL, \"linked_account_id\" INTEGER NULL REFERENCES accounts (id) ON DELETE RESTRICT, \"closing_day\" INTEGER NULL CHECK(\"closing_day\" BETWEEN 1 AND 31), \"due_day\" INTEGER NULL CHECK(\"due_day\" BETWEEN 1 AND 31), \"created_at\" INTEGER NOT NULL DEFAULT (CAST(strftime('%s', CURRENT_TIMESTAMP) AS INTEGER)));"
        }
      ]
    },
    {
      "name": "entries",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"entries\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"account_id\" INTEGER NOT NULL REFERENCES accounts (id) ON DELETE RESTRICT, \"to_account_id\" INTEGER NULL REFERENCES accounts (id) ON DELETE RESTRICT, \"type\" TEXT NOT NULL, \"description\" TEXT NOT NULL, \"amount_cents\" INTEGER NOT NULL CHECK(\"amount_cents\" > 0), \"date\" INTEGER NOT NULL, \"note\" TEXT NULL, \"competence\" INTEGER NOT NULL, \"created_at\" INTEGER NOT NULL DEFAULT (CAST(strftime('%s', CURRENT_TIMESTAMP) AS INTEGER)));"
        }
      ]
    },
    {
      "name": "app_settings",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"app_settings\" (\"id\" INTEGER NOT NULL CHECK(\"id\" = 1), \"month_start_day\" INTEGER NOT NULL DEFAULT 1 CHECK(\"month_start_day\" BETWEEN 1 AND 31), \"theme_mode\" INTEGER NOT NULL DEFAULT 0, \"text_scale\" REAL NOT NULL DEFAULT 1.0, \"high_contrast\" INTEGER NOT NULL DEFAULT 0 CHECK (\"high_contrast\" IN (0, 1)), PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "import_bank_mappings",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"import_bank_mappings\" (\"raw_key\" TEXT NOT NULL, \"account_id\" INTEGER NOT NULL REFERENCES accounts (id) ON DELETE RESTRICT, PRIMARY KEY (\"raw_key\"));"
        }
      ]
    },
    {
      "name": "entries_competence",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE INDEX entries_competence ON entries (competence)"
        }
      ]
    }
